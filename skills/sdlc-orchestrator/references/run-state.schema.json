{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC run state",
  "type": "object",
  "required": ["feature", "stage", "status", "completed_tickets", "failed_attempts", "next_action", "activated_skills"],
  "properties": {
    "feature": {"type": "string"},
    "stage": {"enum": ["clarify", "specify", "ticket", "design", "implement", "test", "review", "verify", "ship", "done", "blocked"]},
    "status": {"enum": ["active", "paused", "blocked", "complete"]},
    "current_ticket": {"type": ["string", "null"]},
    "completed_tickets": {"type": "array", "items": {"type": "string"}},
    "failed_attempts": {"type": "array", "items": {"type": "object"}},
    "last_verified_commit": {"type": ["string", "null"]},
    "next_action": {"type": "string"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "activated_skills": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}

